# Caddy di container ini hanya melayani app di port 80 internal.
# HTTPS & domain diurus Caddy di VPS yang reverse_proxy ke container ini.
{
	servers {
		# percayai X-Forwarded-* dari Caddy VPS (masuk lewat jaringan bridge Docker)
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# /api/products -> backend:8000/products
	handle_path /api/* {
		reverse_proxy {$BACKEND_URL:backend:8000}
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Vue Router pakai history mode, semua route lain balik ke index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
