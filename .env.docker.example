# Salin ke .env lalu isi: cp .env.docker.example .env
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ganti-password-db
POSTGRES_DB=ecommerce_wad

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Port app di VPS (hanya 127.0.0.1). Caddy VPS: reverse_proxy 127.0.0.1:8080
APP_PORT=8080

# true = isi kategori, produk, akun admin (admin@example.com) & customer (customer@example.com) saat backend start.
# Akun hanya dibuat sekali; password wajib diisi. Set false lagi setelah deploy pertama.
RUN_SEED=true
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
