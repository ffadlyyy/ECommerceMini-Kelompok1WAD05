# Salin ke .env lalu isi: cp .env.docker.example .env
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ganti-password-db
POSTGRES_DB=ecommerce_wad

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Port app di VPS (hanya 127.0.0.1). Caddy VPS: reverse_proxy 127.0.0.1:8080
APP_PORT=8080

# true = isi kategori, produk, dan akun demo saat backend start
RUN_SEED=true
