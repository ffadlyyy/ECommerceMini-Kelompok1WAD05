          <circle cx="150" cy="170" r="5" stroke="#413333" stroke-width="1.4"/>
          <path d="M30 100 C 20 80 28 55 45 50 C 55 40 72 48 68 65 C 80 62 85 82 68 90 C 66 105 40 108 30 100Z" stroke="#413333" stroke-width="1.5"/>
          <line x1="45" y1="90" x2="45" y2="150" stroke="#413333" stroke-width="1.5"/>
        </svg>
      </div>
      <div class="hero-chip">
        <div class="dot"></div>
        <div>
          <div class="t1">Sedang laris</div>
          <div class="t2">Lounge Chair Rotan</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CATEGORIES -->
<section class="section" id="rooms">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Belanja per ruang</h2>
        <p>Mulai dari satu sudut, atau lengkapi seluruh rumah.</p>
      </div>
    </div>
    <div class="cat-grid">
      <a class="cat-tile" href="#">
        <div class="cat-icon"><svg viewBox="0 0 24 24"><path d="M4 18V10a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8"/><path d="M2 18h20"/><path d="M6 8V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2"/></svg></div>
        <span>Ruang tamu</span>
      </a>
      <a class="cat-tile" href="#">
        <div class="cat-icon"><svg viewBox="0 0 24 24"><line x1="12" y1="2" x2="12" y2="9"/><path d="M6 9h12l3 11H3L6 9z"/></svg></div>
        <span>Pencahayaan</span>
      </a>
      <a class="cat-tile" href="#">
        <div class="cat-icon"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="12" rx="2"/><path d="M4 17c1-3 15-3 16 0"/></svg></div>
        <span>Tekstil</span>
      </a>
      <a class="cat-tile" href="#">
        <div class="cat-icon"><svg viewBox="0 0 24 24"><path d="M6 3h12l-1 9a5 5 0 0 1-10 0L6 3z"/><path d="M9 3v3M15 3v3"/></svg></div>
        <span>Meja makan</span>
      </a>
      <a class="cat-tile" href="#">
        <div class="cat-icon"><svg viewBox="0 0 24 24"><rect x="4" y="7" width="16" height="13" rx="2"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg></div>
        <span>Penyimpanan</span>
      </a>
      <a class="cat-tile" href="#">
        <div class="cat-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg></div>
        <span>Dekorasi</span>
      </a>
    </div>
  </div>
</section>

<!-- NEW ARRIVALS -->
<section class="section" id="new">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2>Baru datang minggu ini</h2>
        <p>Barang-barang segar yang baru sampai di gudang kami.</p>
      </div>
      <a href="#shop" class="see-all">Lihat semua</a>
